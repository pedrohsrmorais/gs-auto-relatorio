{
  "name": "studio-fiscal-api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST (Express + MySQL) para a plataforma de analise de creditos tributarios do Grupo Studio",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:controllers": "node tests/controllers.smoke-test.js",
    "test:http": "node tests/http.smoke-test.js",
    "test": "npm run test:controllers && npm run test:http"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.0",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
